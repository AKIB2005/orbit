{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/ai/command",
      "destination": "/api/ai"
    },
    {
      "source": "/api/github/:action",
      "destination": "/api/github"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
