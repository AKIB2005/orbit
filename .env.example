# =======================================================
# ORBIT // Environment Configuration Template
# =======================================================

# Supabase (Client-Side Public Config)
# If omitted, ORBIT runs in zero-latency offline IndexedDB mode.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Gemini API (Server-Side Only - Never exposed to client)
# If omitted, ORBIT falls back to built-in Local Cognitive Engine.
GEMINI_API_KEY=your-gemini-api-key

# GitHub OAuth App (Server-Side Only - Never exposed to client)
# If omitted, ORBIT uses read-only simulated telemetry pipeline.
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
